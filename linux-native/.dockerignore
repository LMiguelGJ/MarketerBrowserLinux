# Dependencies are installed inside the image with `npm ci`.
node_modules
npm-debug.log*

# Runtime data and user data never go into an image.
data
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Credentials. A profile export bundles the profile cookies.
.env
.env.*
*.mbl.json
*.har
*.pem
*.key
*.p12
*.pfx

# Not needed at runtime.
.git
.gitignore
.dockerignore
docs
tests
scripts
README.md
compose.yaml
compose.override.y*ml
test-results
playwright-report
coverage
*.log
