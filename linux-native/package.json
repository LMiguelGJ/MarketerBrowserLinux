{
  "name": "mbl-linux-native",
  "version": "0.1.0",
  "private": true,
  "description": "Linux-native web front end for multi-profile browser management",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-sqlite --test \"tests/unit/*.test.js\"",
    "test:integration": "node --experimental-sqlite --test \"tests/integration/*.test.js\"",
    "test:e2e": "node --experimental-sqlite --test \"tests/e2e/*.spec.js\"",
    "test:docker": "bash scripts/test-docker.sh"
  },
  "dependencies": {
    "playwright": "1.49.1"
  }
}
