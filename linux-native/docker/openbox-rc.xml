<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Openbox configuration for a kiosk-style display.

  The application draws its own title bar, so its main window is shown
  maximized and undecorated: the browser tab shows the application and
  nothing else. Dialogs keep ordinary frames so they stay usable.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Primary</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <popupTime>0</popupTime>
  </desktops>

  <margins>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margins>
  <keyboard>
    <!--
      The floating buttons of the viewer send these combinations over the VNC
      connection, so the operator can bring a window to the front from the web
      page. They are also usable from a native VNC client.
    -->
    <keybind key="C-F1">
      <action name="Execute">
        <command>/opt/mbl/raise-window.sh app</command>
      </action>
    </keybind>
    <keybind key="C-F2">
      <action name="Execute">
        <command>/opt/mbl/raise-window.sh browser</command>
      </action>
    </keybind>
    <keybind key="C-F3">
      <action name="Execute">
        <command>/opt/mbl/launch-browser.sh</command>
      </action>
    </keybind>
    <keybind key="C-F4">
      <action name="Execute">
        <command>/opt/mbl/show-last-error.sh</command>
      </action>
    </keybind>
  </keyboard>

  <applications>
    <!-- The real main window of MarketerBrowserLite. -->
    <application name="marketerbrowserlite.exe" title="MainForm">
      <decor>no</decor>
      <!--
        Not "maximized": the application draws its own title bar and a
        maximized state cuts it off. Fixed position and size fill the screen
        and keep the layout intact.
      -->
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
      <size>
        <width>100%</width>
        <height>100%</height>
      </size>
      <focus>yes</focus>
      <layer>normal</layer>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
    </application>

    <!--
      Every other window of the application (side panels and message boxes).
      The first matching rule wins, so this one only applies to what the rule above
      did not take. Message boxes are opened as transient windows of an invisible
      helper window; the window manager then stacks them at the very bottom, under
      the main window, where they cannot be seen or answered. The upper layer keeps
      them visible. Browser windows of the profiles belong to another program and
      are not affected.
    -->
    <application name="marketerbrowserlite.exe">
      <layer>above</layer>
    </application>

    <!--
      A browser window of a launched profile fills the screen, like the
      application window: the viewer shows one surface at a time. It keeps its
      decorations, so the operator can maximise, minimise and close it; the
      watchdog decides what takes the screen when that happens.
    -->
    <application name="chrome.exe">
      <decor>yes</decor>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
      <size>
        <width>100%</width>
        <height>100%</height>
      </size>
      <focus>yes</focus>
      <layer>above</layer>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
    </application>
  </applications>
</openbox_config>
